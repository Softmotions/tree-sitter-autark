# Highlight regression fixture for the current query model.

meta {
  name { demo }
  vendor { Softmotions }
}

cc {
  objects { CC_OBJS }
  consumes { LIBA }
  produces { app }
}

cxx {
  objects { CXX_OBJS }
}

run {
  always
  exec { runner }
  shell { /bin/sh }
  consumes { CC_OBJS }
  produces { app }
}

run-on-install {
  always
  exec { installer }
}

echo {
  init { init-message }
  setup { setup-message }
  build { build-message }
  post-build { post-message }
}

check {
  system.sh
  test_blocks.sh { IW_BLOCKS }
}

set {
  parent { SET_PARENT }
  value
}

let {
  LET_NAME
  value
}

env {
  ENV_NAME
  value
}

option { OPT_NAME "Enable option" }
macro { MACRO_NAME body }
foreach { ITEM LIST }

library {
  root { LIB_ROOT }
}

call { MACRO_NAME arg }

if {
  and {
    !eq { A B }
    defined { C }
    or {
      prefix { D E }
    }
  }
  eq { F G }
}

!if { defined { H } }
else { fallback }

include { distr.autark }
install-sources { src }

${X}
!@{cmd}
..@{cmd}
..@@{cmd}
!C{file.c}
&{1}

custom-rule { bare-value }
