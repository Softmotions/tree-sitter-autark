check {
  system.sh
  test_blocks.sh { IW_BLOCKS }
}

set {}
!set {}
..set {}
..!set {}
let {}
!let {}
..let {}
..!let {}
if {}
!if {}
defined {}
!defined {}

${X}
!${X}
..${X}
..!${X}
@{x}
!@{x}
C{x}
!C{x}

# Unsupported modifier combinations must not look like built-ins.
!meta {}
..meta {}
..if {}
..defined {}
..@{x}
..!@{x}
..C{x}
!&{x}

# Long set value list: every bare value after the variable name must be captured.
set {
  CFLAGS
  -std=gnu11
  -fsigned-char
  -Wall
  -Wextra
  -Wfatal-errors
  -Wno-implicit-fallthrough
  -Wno-missing-braces
  -Wno-missing-field-initializers
  -Wno-sign-compare
  -Wno-unknown-pragmas
  -Wno-unused-function
  -Wno-unused-parameter
  -Wno-overlength-strings
  -fPIC
  ..@@{${PKGCONF} --cflags libiowow}
}
